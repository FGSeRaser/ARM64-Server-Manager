#!/bin/bash
# Backs up the worlds to /root/backups. Language: APP_LANG=de|en
BACKUP_DIR="/root/backups"
TIMESTAMP=$(date +"%Y-%m-%d_%H-%M-%S")
SOURCE_DIR="/root/minecraft-server/worlds"
if [ "$APP_LANG" = "de" ]; then
  M_RUN="Sichere Minecraft-Welten..."; M_OK="Backup gespeichert:"; M_ERR="Fehler: Ordner 'worlds' wurde nicht gefunden!"
else
  M_RUN="Backing up Minecraft worlds..."; M_OK="Backup saved:"; M_ERR="Error: folder 'worlds' not found!"
fi
mkdir -p "$BACKUP_DIR"
if [ -d "$SOURCE_DIR" ]; then
    echo "$M_RUN"
    tar -czf "$BACKUP_DIR/world_backup_$TIMESTAMP.tar.gz" -C /root/minecraft-server worlds
    echo "$M_OK $BACKUP_DIR/world_backup_$TIMESTAMP.tar.gz"
    # keep only the 5 newest backups inside the app (exported copies stay untouched)
    ls -1t "$BACKUP_DIR"/world_backup_*.tar.gz 2>/dev/null | tail -n +6 | while read -r old; do rm -f "$old"; done
    ls -lh "$BACKUP_DIR" | tail -n 5
else
    echo "$M_ERR"; exit 1
fi
